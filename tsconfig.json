{
  "compilerOptions": {
    "outDir": "dist", "module": "ESNext", "target": "ES2020",
    "jsx": "react-jsx", "moduleResolution": "node", "strict": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "esModuleInterop": true, "noImplicitReturns": true,
    "allowSyntheticDefaultImports": true, "skipLibCheck": true
  },
  "include": ["src"]
}
