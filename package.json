{
    "name": "decky-vpn",
    "version": "0.2.8",
    "description": "DeckPort VPN - subscription VPN inside Steam Deck Gaming Mode",
    "type": "module",
    "license": "GPL-3.0-or-later",
    "scripts": {
        "build": "rollup -c",
        "typecheck": "tsc --noEmit",
        "test": "python -m unittest discover -s tests -v",
        "package": "python scripts/package.py"
    },
    "devDependencies": {
        "@decky/rollup": "1.0.2",
        "@decky/ui": "^4.11.0",
        "@types/react": "19.1.1",
        "@types/react-dom": "19.1.1",
        "rollup": "^4.53.3",
        "typescript": "^5.6.2"
    },
    "dependencies": {
        "@decky/api": "^1.1.3",
        "react-icons": "^5.3.0",
        "tslib": "^2.7.0"
    },
    "pnpm": {
        "peerDependencyRules": {
            "ignoreMissing": [
                "react",
                "react-dom"
            ]
        }
    }
}
